+            val file = java.io.File(defaultDataDirectory(), "media-controls.log")
+            file.parentFile?.mkdirs()
+            if (file.length() > 64_000) file.delete()
+            file.appendText("${java.time.LocalDateTime.now()} $what${error?.let { ": $it" } ?: ""}\n")
+        }
     }
 

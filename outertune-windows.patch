+/*
+ * Copyright (C) 2026 OuterTune Project
+ *
+ * SPDX-License-Identifier: GPL-3.0
+ */
+
+package com.dd3boh.outertune.desktop
+
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.cos
+import kotlin.math.roundToLong
+import kotlin.math.sin
+
+/** How much high-frequency restoration to apply. Same steps and amounts as the phone. */
+enum class AudioUpscaling(val label: String, val amount: Float) {
+    Off("Off", 0f),
+    Subtle("Subtle", 0.3f),
+    Balanced("Balanced", 0.5f),
+    Strong("Strong", 0.8f),
+}
+
+/**
+ * High-frequency restoration: puts back the top octave a lossy codec threw away by generating
+ * harmonics of what survived. A port of the phone's `audio/HarmonicExciter.kt`, with the same band
+ * plan and constants, so a setting means the same thing on both.
+ *
+ * The chain: band-limit the input to [cutoff/2, sampleRate/4] (so the second harmonic can never
+ * alias), run it through a biased soft saturator, keep only [cutoff, 0.95 * Nyquist] of the result
+ * and mix it back in at low level. Per-sample, allocation-free, no transform.
+ *
+ * Off by default, and does nothing for lossless or Opus, or when the stream's cutoff leaves no gap.
+ */
+class HarmonicExciter {
+
+    private class Section {
+        var b0 = 1f; var b1 = 0f; var b2 = 0f; var a1 = 0f; var a2 = 0f
+        private var x1 = 0f; private var x2 = 0f; private var y1 = 0f; private var y2 = 0f
+
+        fun process(x: Float): Float {
+            val y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2
+            x2 = x1; x1 = x
+            y2 = y1; y1 = if (y.isFinite()) y else 0f
+            return y1
+        }
+
+        fun reset() { x1 = 0f; x2 = 0f; y1 = 0f; y2 = 0f }
+
+        /** RBJ cookbook Butterworth low/high-pass. */
+        fun setPass(freqHz: Float, sampleRate: Int, high: Boolean) {
+            val w0 = 2.0 * PI * freqHz / sampleRate
+            val cosw = cos(w0)
+            val alpha = sin(w0) / (2.0 * Q)
+            val a0 = 1.0 + alpha
+            val nb0: Double; val nb1: Double; val nb2: Double
+            if (high) {
+                nb0 = (1 + cosw) / 2; nb1 = -(1 + cosw); nb2 = (1 + cosw) / 2
+            } else {
+                nb0 = (1 - cosw) / 2; nb1 = 1 - cosw; nb2 = (1 - cosw) / 2
+            }
+            b0 = (nb0 / a0).toFloat(); b1 = (nb1 / a0).toFloat(); b2 = (nb2 / a0).toFloat()
+            a1 = (-2 * cosw / a0).toFloat(); a2 = ((1 - alpha) / a0).toFloat()
+        }
+    }
+
+    @Volatile var enabled = false
+    @Volatile var amount = DEFAULT_AMOUNT
+    @Volatile var evenness = DEFAULT_EVENNESS
+
+    @Volatile private var active = false
+    private var channels = 0
+    private var configuredRate = 0
+    private var configuredCutoff = 0f
+
+    private var inHigh = emptyArray<Array<Section>>()
+    private var inLow = emptyArray<Array<Section>>()
+    private var outHigh = emptyArray<Array<Section>>()
+    private var outLow = emptyArray<Array<Section>>()
+
+    /** Plans the bands for a stream whose content stops at [cutoffHz]. False when there is no gap to fill. */
+    fun configure(sampleRate: Int, channelCount: Int, cutoffHz: Float?): Boolean {
+        if (cutoffHz == null || sampleRate == configuredRate && channelCount == channels &&
+            cutoffHz == configuredCutoff && inHigh.isNotEmpty()
+        ) {
+            if (cutoffHz == null) active = false
+            return active
+        }
+        active = false
+        if (sampleRate <= 0 || channelCount <= 0) return false
+        val nyquist = sampleRate / 2f
+        if (cutoffHz <= 0f || cutoffHz >= nyquist - MIN_GAP_HZ) return false
+        val inLowHz = cutoffHz / 2f
+        val inHighHz = sampleRate / 4f
+        if (inHighHz <= inLowHz * INPUT_BAND_MIN_RATIO) return false
+
+        fun chain(freq: Float, high: Boolean) = Array(channelCount) {
+            Array(SECTIONS) { Section().also { s -> s.setPass(freq, sampleRate, high) } }
+        }
+        inHigh = chain(inLowHz, true)
+        inLow = chain(inHighHz, false)
+        outHigh = chain(cutoffHz, true)
+        outLow = chain(nyquist * CEILING_FRACTION, false)
+        channels = channelCount
+        configuredRate = sampleRate
+        configuredCutoff = cutoffHz
+        active = true
+        return true
+    }
+
+    fun reset() {
+        for (set in arrayOf(inHigh, inLow, outHigh, outLow)) set.forEach { c -> c.forEach { it.reset() } }
+    }
+
+    fun isActive(): Boolean = active && enabled && amount > 0f
+
+    /** Processes one interleaved PCM block in place. Does nothing when inactive. */
+    fun process(bytes: ByteArray, length: Int, bitsPerSample: Int, channelCount: Int, bigEndian: Boolean) {
+        if (!isActive() || channelCount != channels) return
+        val bps = bitsPerSample / 8
+        if (bps !in 1..4) return
+        val peak = (1L shl (bitsPerSample - 1)).toFloat()
+        val maxV = peak.toLong() - 1
+        val gain = amount * WET_TRIM
+        val frames = length / (bps * channelCount)
+        var pos = 0
+        for (f in 0 until frames) {
+            for (c in 0 until channelCount) {
+                val dry = Pcm.readSample(bytes, pos, bps, bigEndian).toFloat() / peak
+                var x = dry
+                for (s in inHigh[c]) x = s.process(x)
+                for (s in inLow[c]) x = s.process(x)
+                x = shape(x)
+                for (s in outHigh[c]) x = s.process(x)
+                for (s in outLow[c]) x = s.process(x)
+                val out = ((dry + x * gain) * peak).roundToLong().coerceIn(-peak.toLong(), maxV)
+                Pcm.writeSample(bytes, pos, bps, bigEndian, out)
+                pos += bps
+            }
+        }
+    }
+
+    private fun shape(x: Float): Float {
+        val bias = evenness.coerceIn(0f, 1f) * MAX_BIAS
+        return softSaturate(x * DRIVE_GAIN + bias) - softSaturate(bias)
+    }
+
+    private fun softSaturate(x: Float) = (1f + MAX_DRIVE) * x / (1f + MAX_DRIVE * abs(x))
+
+    companion object {
+        const val DEFAULT_AMOUNT = 0.5f
+        const val DEFAULT_EVENNESS = 0.8f
+        private const val MAX_DRIVE = 0.6f
+        private const val DRIVE_GAIN = 64f
+        private const val MAX_BIAS = 0.35f
+        private const val WET_TRIM = 0.25f
+        private const val MIN_GAP_HZ = 1_500f
+        private const val INPUT_BAND_MIN_RATIO = 1.2f
+        private const val CEILING_FRACTION = 0.95f
+        private const val Q = 0.7071
+        private const val SECTIONS = 2
+
+        /**
+         * Where a stream's content stops, from the format text this app shows. Null means leave it
+         * alone: lossless, Opus, or anything unrecognised.
+         */
+        fun cutoffFor(format: String?, bitrateKbps: Int?): Float? {
+            val f = format?.lowercase() ?: return null
+            val bps = bitrateKbps?.let { it * 1000 }
+            return when {
+                "flac" in f || "alac" in f || "wav" in f || "pcm" in f || "opus" in f -> null
+                "aac" in f || "m4a" in f || "mp4" in f -> when {
+                    bps == null -> 16_000f
+                    bps >= 250_000 -> 19_000f
+                    bps >= 190_000 -> 18_000f
+                    bps >= 120_000 -> 16_000f
+                    else -> 14_000f
+                }
+                "mp3" in f || "mpeg" in f -> when {
+                    bps == null -> 16_000f
+                    bps >= 300_000 -> 19_000f
+                    bps >= 190_000 -> 18_000f
+                    bps >= 120_000 -> 16_000f
+                    else -> 15_000f
+                }
+                else -> null
+            }
+        }
+    }
+}

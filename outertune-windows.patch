+
+/** One wanted song, before it is matched to anything. [videoId] is set when the source names the exact video. */
+data class WantedTrack(val title: String, val artists: List<String>, val raw: String, val videoId: String? = null)
+
+/**
+ * Reading playlists written by other tools, and matching them to songs on YouTube Music.
+ * The same parsing and wording as the phone's importer: CSV (Exportify and friends), a plain
+ * `Artist - Title` list, and M3U.
+ */
+object PlaylistImport {
+
+    /**
+     * A CSV playlist: the title and artist columns are found by header name, so column order and
+     * extra columns do not matter. Null when there is no recognisable title column.
+     */
+    fun parseCsv(text: String): List<WantedTrack>? {
+        val rows = csvRows(text.removePrefix("﻿"))
+        if (rows.isEmpty()) return emptyList()
+        val header = rows.first().map { it.trim().lowercase() }
+        val titleKeys = listOf("track name", "track", "title", "song name", "song", "name")
+        val artistKeys = listOf("artist name(s)", "artist names", "artist name", "artists", "artist")
+        val titleCol = titleKeys.firstNotNullOfOrNull { k -> header.indexOf(k).takeIf { it >= 0 } } ?: return null
+        val artistCol = artistKeys.firstNotNullOfOrNull { k -> header.indexOf(k).takeIf { it >= 0 } }
+        return rows.drop(1).mapNotNull { row ->
+            val title = row.getOrNull(titleCol)?.trim().orEmpty()
+            if (title.isEmpty()) return@mapNotNull null
+            val artists = artistCol?.let { row.getOrNull(it) }
+                ?.split(';')?.map { it.trim() }?.filter { it.isNotEmpty() }.orEmpty()
+            WantedTrack(title, artists, row.joinToString(","))
+        }
+    }
+
+    /** One song per line, `Artist - Title`; `;` between several artists. A line without " - " is searched as written. */
+    fun parseText(text: String): List<WantedTrack> =
+        text.lineSequence().map { it.trim() }.filter { it.isNotEmpty() && !it.startsWith("#") }.map { line ->
+            if (" - " in line) {
+                WantedTrack(
+                    title = line.substringAfter(" - ").trim(),
+                    artists = line.substringBefore(" - ").split(';').map { it.trim() }.filter { it.isNotEmpty() },
+                    raw = line,
+                )
+            } else WantedTrack(line, emptyList(), line)
+        }.toList()
+
+    /** M3U written by the phone or by this app: `#EXTINF:<s>,<artists> - <title>`, then the song's location. */
+    fun parseM3u(text: String): List<WantedTrack> {
+        val lines = text.lines()
+        val out = ArrayList<WantedTrack>()
+        lines.forEachIndexed { i, raw ->
+            if (!raw.startsWith("#EXTINF:")) return@forEachIndexed
+            val info = raw.substringAfter("#EXTINF:").substringAfter(',')
+            val artists = info.substringBefore(" - ", "").split(';').map { it.trim() }.filter { it.isNotEmpty() }
+            val title = if (" - " in info) info.substringAfter(" - ").trim() else info.trim()
+            val source = lines.getOrNull(i + 1)?.trim().orEmpty()
+            // A YouTube link names the exact video, so it is trusted instead of searched for.
+            val id = if (source.startsWith("http") && "watch?v=" in source)
+                source.substringAfter("watch?v=").substringBefore("&") else null
+            if (title.isNotEmpty()) out.add(WantedTrack(title, artists, raw.substringAfter("#EXTINF:").substringAfter(','), id))
+        }
+        return out
+    }
+
+    /** RFC 4180 rows: quoted fields, doubled quotes, comma / semicolon / tab, CRLF or LF. */
+    internal fun csvRows(text: String): List<List<String>> {
+        val firstLine = text.lineSequence().firstOrNull().orEmpty()
+        val delimiter = listOf(',', ';', '\t').maxByOrNull { d -> firstLine.count { it == d } }
+            ?.takeIf { d -> firstLine.contains(d) } ?: ','
+        val rows = ArrayList<List<String>>()
+        var row = ArrayList<String>()
+        val field = StringBuilder()
+        var quoted = false
+        var i = 0
+        while (i < text.length) {
+            val c = text[i]
+            when {
+                quoted && c == '"' && text.getOrNull(i + 1) == '"' -> { field.append('"'); i++ }
+                c == '"' -> quoted = !quoted
+                !quoted && c == delimiter -> { row.add(field.toString()); field.clear() }
+                !quoted && (c == '\n' || c == '\r') -> {
+                    if (c == '\r' && text.getOrNull(i + 1) == '\n') i++
+                    row.add(field.toString()); field.clear()
+                    if (row.any { it.isNotBlank() }) rows.add(row)
+                    row = ArrayList()
+                }
+                else -> field.append(c)
+            }
+            i++
+        }
+        if (field.isNotEmpty() || row.isNotEmpty()) {
+            row.add(field.toString())
+            if (row.any { it.isNotBlank() }) rows.add(row)
+        }
+        return rows
+    }
+
+    /** Lower-case, without bracketed notes or " - Remastered" tails, punctuation and spacing. */
+    private fun simple(s: String): String = s.lowercase()
+        .replace(Regex("\\(.*?\\)|\\[.*?]"), " ")
+        .substringBefore(" - ")
+        .replace(Regex("[^\\p{L}\\p{N}]+"), " ").trim()
+
+    private fun closeEnough(wanted: WantedTrack, found: SongItem): Boolean {
+        val a = simple(wanted.title)
+        val b = simple(found.title)
+        val titleOk = a.isNotEmpty() && (a == b || a in b || b in a)
+        if (!titleOk) return false
+        if (wanted.artists.isEmpty()) return true
+        val credits = found.artists.map { simple(it.name) }
+        return wanted.artists.any { w ->
+            val s = simple(w)
+            credits.any { it == s || it in s || s in it }
+        }
+    }
+
+    /**
+     * Matches each wanted song to a YouTube Music song. By default a result has to agree on the title
+     * and an artist; with [closest] the top result is taken, which finds more and is wrong more often.
+     * A line with no artist is a search phrase, so its top result is taken either way.
+     */
+    suspend fun match(
+        wanted: List<WantedTrack>,
+        closest: Boolean,
+        onProgress: (Int, Int) -> Unit,
+    ): Pair<List<SongItem>, List<String>> = withContext(Dispatchers.IO) {
+        val songs = ArrayList<SongItem>()
+        val rejected = ArrayList<String>()
+        wanted.forEachIndexed { index, track ->
+            onProgress(index, wanted.size)
+            var found: SongItem? = track.videoId?.let { id ->
+                YouTube.queue(listOf(id)).getOrNull()?.firstOrNull()
+            }
+            if (found == null) {
+                val results = YouTube.search(
+                    "${track.title} ${track.artists.joinToString(" ")}".trim(),
+                    YouTube.SearchFilter.FILTER_SONG,
+                ).getOrNull()?.items?.filterIsInstance<SongItem>().orEmpty()
+                found = if (closest || track.artists.isEmpty()) results.firstOrNull()
+                else results.firstOrNull { closeEnough(track, it) }
+            }
+            if (found != null && songs.none { it.id == found.id }) songs.add(found)
+            else if (found == null) rejected.add(track.raw)
+        }
+        onProgress(wanted.size, wanted.size)
+        songs to rejected
+    }
+}
+
+/**
+ * Import playlist (M3U / CSV / text): pick a source, see what matched, and make the playlist.
+ * [onCreate] gets the name and the songs, and does the rest.
+ */
+@Composable
+fun ImportPlaylistDialog(
+    onDismiss: () -> Unit,
+    onCreate: (String, List<SongItem>) -> Unit,
+) {
+    val scope = rememberCoroutineScope()
+    var busy by remember { mutableStateOf(false) }
+    var progress by remember { mutableStateOf<Pair<Int, Int>?>(null) }
+    var closest by remember { mutableStateOf(false) }
+    var name by remember { mutableStateOf("") }
+    var pasting by remember { mutableStateOf(false) }
+    var pasted by remember { mutableStateOf("") }
+    var problem by remember { mutableStateOf<String?>(null) }
+    val matched = remember { mutableStateListOf<SongItem>() }
+    val rejected = remember { mutableStateListOf<String>() }
+
+    fun run(suggestedName: String, load: suspend () -> List<WantedTrack>?) {
+        scope.launch {
+            busy = true
+            problem = null
+            matched.clear(); rejected.clear()
+            try {
+                val wanted = load()
+                if (wanted == null) {
+                    problem = "Couldn't find a title column. The first row needs headers such as Track Name and Artist Name(s)."
+                } else {
+                    val (songs, missed) = PlaylistImport.match(wanted, closest) { d, t -> progress = d to t }
+                    matched.addAll(songs); rejected.addAll(missed)
+                    if (name.isBlank()) name = suggestedName
+                    if (songs.isEmpty()) problem = "No songs found. The file is empty, or nothing matched."
+                }
+            } catch (e: Exception) {
+                problem = "Import failed: ${e.message ?: e::class.simpleName}"
+            } finally {
+                busy = false
+                progress = null
+            }
+        }
+    }
+
+    fun fromFile(title: String, label: String, spec: String, parse: (String) -> List<WantedTrack>?) {
+        scope.launch {
+            val file: File = FilePicker.pickFile(title, label, spec) ?: return@launch
+            run(file.nameWithoutExtension) { withContext(Dispatchers.IO) { parse(file.readText()) } }
+        }
+    }
+
+    AlertDialog(
+        onDismissRequest = { if (!busy) onDismiss() },
+        title = { Text("Import playlist") },
+        text = {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp), modifier = Modifier.width(420.dp)) {
+                if (pasting) {
+                    Text("One song per line, as Artist - Title. Separate several artists with a semicolon. A line with only a title is searched as it is.", style = MaterialTheme.typography.bodySmall)
+                    OutlinedTextField(
+                        value = pasted, onValueChange = { pasted = it },
+                        modifier = Modifier.fillMaxWidth().heightIn(min = 140.dp, max = 240.dp),
+                        placeholder = { Text("Artist - Title") },
+                    )
+                    Row {
+                        TextButton(onClick = { pasting = false }) { Text("Back") }
+                        TextButton(onClick = {
+                            fromFile("Choose a text file", "Text file", "*.txt") { PlaylistImport.parseText(it) }
+                            pasting = false
+                        }) { Text("Choose a file") }
+                        TextButton(
+                            enabled = pasted.isNotBlank() && !busy,
+                            onClick = { pasting = false; run("") { PlaylistImport.parseText(pasted) } },
+                        ) { Text("Import") }
+                    }
+                } else {
+                    OutlinedButton(enabled = !busy, modifier = Modifier.fillMaxWidth(), onClick = {
+                        fromFile("Choose an M3U playlist", "M3U playlist", "*.m3u;*.m3u8") { PlaylistImport.parseM3u(it) }
+                    }) { Text("Import playlist (M3U)") }
+                    OutlinedButton(enabled = !busy, modifier = Modifier.fillMaxWidth(), onClick = {
+                        fromFile("Choose a CSV playlist", "CSV file", "*.csv") { PlaylistImport.parseCsv(it) }
+                    }) { Text("Import playlist (CSV)") }
+                    OutlinedButton(enabled = !busy, modifier = Modifier.fillMaxWidth(), onClick = { pasting = true }) {
+                        Text("Import playlist (text)")
+                    }
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        Checkbox(checked = closest, onCheckedChange = { closest = it })
+                        Text("Take the closest match when the title or artist differs", style = MaterialTheme.typography.bodySmall)
+                    }
+                }
+
+                progress?.let { (d, t) -> Text("Matching $d / $t…", style = MaterialTheme.typography.bodySmall) }
+                problem?.let { Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall) }
+
+                if (matched.isNotEmpty()) {
+                    OutlinedTextField(
+                        value = name, onValueChange = { name = it },
+                        label = { Text("Playlist name") }, singleLine = true,
+                        modifier = Modifier.fillMaxWidth(),
+                    )
+                    Text("Successfully imported: ${matched.size}", style = MaterialTheme.typography.titleSmall)
+                }
+                if (rejected.isNotEmpty()) {
+                    Text("Could not import: ${rejected.size}", style = MaterialTheme.typography.titleSmall)
+                    LazyColumn(modifier = Modifier.heightIn(max = 120.dp)) {
+                        items(rejected) { Text(it, style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(vertical = 2.dp)) }
+                    }
+                }
+            }
+        },
+        confirmButton = {
+            Button(
+                enabled = matched.isNotEmpty() && name.isNotBlank() && !busy,
+                onClick = { onCreate(name.trim(), matched.toList()); onDismiss() },
+            ) { Text("Create playlist") }
+        },
+        dismissButton = { TextButton(enabled = !busy, onClick = onDismiss) { Text("Cancel") } },
+    )
+}

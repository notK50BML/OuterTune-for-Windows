+                    parameter("a", artist)
+                    if (duration > 0) parameter("d", duration)
+                    if (!album.isNullOrBlank()) parameter("al", album)
+                }
+            }.onFailure { if (it is kotlinx.coroutines.CancellationException) throw it; failure = it }.getOrNull()

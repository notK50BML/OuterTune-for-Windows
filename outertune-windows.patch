+    /**
+     * Writes a playlist's order. [moved] is the song that was dragged, when one was: for a playlist
+     * kept on the account the move is sent there too, as the phone sends it.
+     */
+    fun reorderPlaylist(playlistId: String, songIdsInOrder: List<String>, moved: String? = null) {
         db.reorderPlaylist(playlistId, songIdsInOrder)
+        if (moved == null || LocalMusic.isLocal(moved)) return
+        mirror(playlistId, "move the song") { remote ->
+            // YouTube moves an entry to sit before another entry, both named by their place in the
+            // playlist rather than by song - so the account's own list is read for them.
+            val onAccount = YouTube.playlist(remote).completed().getOrThrow().songs
+            val entry = onAccount.firstOrNull { it.id == moved }?.setVideoId ?: return@mirror
+            // The song that now follows it here, if the account has it; the account's own order
+            // may differ from this one, so it is found by song and not by position.
+            val after = songIdsInOrder.dropWhile { it != moved }.drop(1)
+                .firstNotNullOfOrNull { next -> onAccount.firstOrNull { it.id == next }?.setVideoId }
+            if (after != null) {
+                YouTube.moveSongPlaylist(remote, entry, after).getOrThrow()
+            } else {
+                // To the very end: YouTube has no "after the last", so as on the phone it goes in front
+                // of the last entry and that entry is then put in front of it.
+                val last = onAccount.lastOrNull { it.id != moved }?.setVideoId ?: return@mirror
+                if (onAccount.last().setVideoId == entry) return@mirror
+                YouTube.moveSongPlaylist(remote, entry, last).getOrThrow()
+                YouTube.moveSongPlaylist(remote, last, entry).getOrThrow()
+            }
+        }
     }
 
     fun refreshAll() {

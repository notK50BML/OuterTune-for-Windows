+    // ---- Hold next to preview --------------------------------------------------------------
+
+    /** Title of the song being previewed, or null when no preview is under way. */
+    val previewTitle = MutableStateFlow<String?>(null)
+    private var previewJob: Job? = null
+    private var previewing = false
+    private var previewOrigin: Triple<Int, Long, Boolean>? = null
+
+    private suspend fun fadePreview(target: Float, ms: Long) {
+        val from = player.previewFactor
+        val steps = (ms / 25).toInt().coerceAtLeast(1)
+        for (i in 1..steps) {
+            player.previewFactor = from + (target - from) * i / steps
+            kotlinx.coroutines.delay(25)
+        }
+        player.previewFactor = target
+    }
+
+    /** Fades out the current song and into the next as a preview. [cancelPreview] returns to where it was. */
+    fun startPreview() {
+        val queue = state.value
+        if (previewing || queue.orderPosition >= queue.order.lastIndex) return
+        val next = queue.upcoming ?: return
+        previewing = true
+        previewOrigin = Triple(queue.orderPosition, player.positionMs.value, player.state.value is PlaybackState.Paused)
+        previewJob?.cancel()
+        previewJob = scope.launch {
+            fadePreview(0f, 250)
+            moveTo(queue.orderPosition + 1)
+            previewTitle.value = next.title
+            fadePreview(1f, 400)
+        }
+    }
+
+    /** Keeps the previewed song, which carries on from however far in the preview got. */
+    fun commitPreview() {
+        if (!previewing) return
+        previewing = false
+        previewOrigin = null
+        previewTitle.value = null
+    }
+
+    /** Fades back to the song that was playing, at the position it was left. */
+    fun cancelPreview() {
+        if (!previewing) return
+        previewing = false
+        val (position, ms, wasPaused) = previewOrigin ?: return
+        previewOrigin = null
+        val pending = previewJob
+        previewJob = scope.launch {
+            pending?.join()
+            fadePreview(0f, 250)
+            moveTo(position, ms)
+            if (wasPaused) player.pause()
+            previewTitle.value = null
+            fadePreview(1f, 400)
+        }
+    }

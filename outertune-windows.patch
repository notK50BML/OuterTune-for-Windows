+            }
+            log?.invoke("$host$path -> HTTP ${response.status.value} (\"$title\" - $artist)")
+            if (response.status == HttpStatusCode.OK) return response
+            last = response
+        }
+        return last ?: throw (failure ?: IOException("BetterLyrics unreachable"))
+    }

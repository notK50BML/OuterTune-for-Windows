@@ -0,0 +1,144 @@
+package com.dd3boh.lrclib
+
+/**
+ * LRCLIB's word-synced lyrics: the `lyricsfile` field of its search and get answers, a YAML document
+ * in the Lyricsfile 1.0 format (https://github.com/tranxuanthang/lyricsfile) - `lines`, each with
+ * `text`, `start_ms`, an optional `end_ms` and an optional `words` list of the same.
+ *
+ * Turned into the TTML the other word-synced providers give, so one parser draws all of them. Only
+ * what the format's `lines` section uses is read - mappings, lists, and plain, single or double
+ * quoted strings and integers - so no YAML library is needed. Anything unexpected gives null and the
+ * caller falls back to the line-synced lyrics.
+ */
+object Lyricsfile {
+    private class Word(var text: String = "", var start: Long = -1, var end: Long = -1)
+    private class Line(var text: String = "", var start: Long = -1, var end: Long = -1, val words: MutableList<Word> = mutableListOf())
+
+    private val ITEM = Regex("""^(\s*)-\s+([A-Za-z_]+):(?:\s+(.*))?$""")
+    private val KEY = Regex("""^(\s+)([A-Za-z_]+):(?:\s+(.*))?$""")
+
+    /** The TTML for [yaml], or null when it holds no word timings. */
+    fun toTtml(yaml: String): String? = runCatching { parse(yaml)?.let(::ttml) }.getOrNull()
+
+    private fun parse(yaml: String): List<Line>? {
+        val rows = yaml.lines()
+        val start = rows.indexOfFirst { it.trimEnd() == "lines:" }
+        if (start < 0) return null
+        val lines = mutableListOf<Line>()
+        var lineIndent = -1
+        var line: Line? = null
+        var word: Word? = null
+        for (i in start + 1 until rows.size) {
+            val row = rows[i]
+            if (row.isBlank()) continue
+            if (!row[0].isWhitespace() && !row.startsWith("-")) break // the next top level key
+            val item = ITEM.find(row)
+            if (item != null) {
+                val indent = item.groupValues[1].length
+                if (lineIndent < 0 || indent <= lineIndent) {
+                    lineIndent = indent
+                    line = Line().also { lines += it }
+                    word = null
+                    assign(line, null, item.groupValues[2], item.groupValues[3])
+                } else {
+                    val l = line ?: return null
+                    word = Word().also { l.words += it }
+                    assign(null, word, item.groupValues[2], item.groupValues[3])
+                }
+                continue
+            }
+            val key = KEY.find(row) ?: continue
+            val indent = key.groupValues[1].length
+            if (indent <= lineIndent + 2 && !(word != null && indent > lineIndent + 2)) {
+                assign(line, null, key.groupValues[2], key.groupValues[3])
+            } else {
+                assign(null, word, key.groupValues[2], key.groupValues[3])
+            }
+        }
+        return lines.takeIf { l -> l.isNotEmpty() && l.any { it.words.isNotEmpty() } }
+    }
+
+    private fun assign(line: Line?, word: Word?, key: String, raw: String) {
+        when (key) {
+            "text" -> (scalar(raw))?.let { line?.text = it; word?.text = it }
+            "start_ms" -> scalar(raw)?.toLongOrNull()?.let { line?.start = it; word?.start = it }
+            "end_ms" -> scalar(raw)?.toLongOrNull()?.let { line?.end = it; word?.end = it }
+        }
+    }
+
+    private fun scalar(raw: String): String? {
+        val s = raw.trim()
+        if (s.isEmpty()) return ""
+        return when (s[0]) {
+            '\'' -> {
+                val out = StringBuilder()
+                var i = 1
+                while (i < s.length) {
+                    if (s[i] == '\'') {
+                        if (i + 1 < s.length && s[i + 1] == '\'') { out.append('\''); i += 2; continue }
+                        return out.toString()
+                    }
+                    out.append(s[i++])
+                }
+                null // runs over to another row: not read
+            }
+            '"' -> {
+                val out = StringBuilder()
+                var i = 1
+                while (i < s.length) {
+                    val c = s[i]
+                    when {
+                        c == '"' -> return out.toString()
+                        c == '\\' && i + 1 < s.length -> {
+                            when (val e = s[i + 1]) {
+                                'n' -> out.append('\n')
+                                't' -> out.append('\t')
+                                'u' -> if (i + 5 < s.length) { out.append(s.substring(i + 2, i + 6).toInt(16).toChar()); i += 4 }
+                                else -> out.append(e)
+                            }
+                            i += 2
+                        }
+                        else -> { out.append(c); i++ }
+                    }
+                }
+                null
+            }
+            else -> s.substringBefore(" #").trim()
+        }
+    }
+
+    private fun ttml(lines: List<Line>): String? {
+        val body = StringBuilder()
+        var written = 0
+        lines.forEachIndexed { index, line ->
+            if (line.start < 0) return@forEachIndexed
+            val words = line.words.filter { it.start >= 0 }
+            val lineEnd = when {
+                line.end >= 0 -> line.end
+                words.lastOrNull()?.end?.let { it >= 0 } == true -> words.last().end
+                else -> lines.getOrNull(index + 1)?.start?.takeIf { it > line.start } ?: (line.start + 3000)
+            }
+            if (line.text.isBlank() && words.isEmpty()) return@forEachIndexed
+            body.append("<p begin=\"").append(seconds(line.start)).append("\" end=\"").append(seconds(lineEnd)).append("\">")
+            if (words.isEmpty()) {
+                body.append(escape(line.text.trim()))
+            } else {
+                words.forEachIndexed { w, word ->
+                    val end = if (word.end >= 0) word.end else words.getOrNull(w + 1)?.start ?: lineEnd
+                    if (word.text.isBlank()) { body.append(' '); return@forEachIndexed }
+                    if (word.text.first().isWhitespace()) body.append(' ')
+                    body.append("<span begin=\"").append(seconds(word.start)).append("\" end=\"")
+                        .append(seconds(maxOf(end, word.start))).append("\">").append(escape(word.text.trim())).append("</span>")
+                    if (word.text.last().isWhitespace()) body.append(' ')
+                }
+            }
+            body.append("</p>")
+            written++
+        }
+        if (written == 0) return null
+        return "<tt xmlns=\"http://www.w3.org/ns/ttml\"><body><div>$body</div></body></tt>"
+    }
+
+    private fun seconds(ms: Long) = "%d.%03d".format(ms / 1000, ms % 1000)
+    private fun escape(s: String) = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+}

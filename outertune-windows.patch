@@ -0,0 +1,142 @@
+package com.dd3boh.betterlyrics
+
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.okhttp.OkHttp
+import io.ktor.client.plugins.HttpTimeout
+import io.ktor.client.request.get
+import io.ktor.client.request.headers
+import io.ktor.client.request.parameter
+import io.ktor.client.statement.bodyAsText
+import io.ktor.http.HttpStatusCode
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.longOrNull
+import java.io.IOException
+
+/**
+ * LyricsPlus, the backend of the YouLy+ browser extension (https://github.com/ibratabian17/lyricsplus).
+ * `GET /v2/lyrics/get` answers with word-timed lines gathered from Apple Music, Musixmatch, Spotify,
+ * QQ and others, as JSON. It is turned into the same TTML the BetterLyrics and QQ results are, so it
+ * is read and drawn by the one parser, with no code of its own downstream.
+ *
+ * Its shape: `lyrics[]` of lines `{time, duration, text, syllabus[], element{singer}}`, each syllable
+ * `{time, duration, text, isBackground}`, times in milliseconds from the start of the song;
+ * `metadata.agents` names the singers (`v1`, `v2`, ...); `type` is Word, Line or None.
+ */
+object LyricsPlus {
+    /** Set by the app to receive one line per request. */
+    @Volatile var log: ((String) -> Unit)? = null
+
+    /** Tried in order; the first to answer 200 wins. */
+    private val HOSTS = listOf("https://lyricsplus.prjktla.my.id")
+
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true }
+
+    private val client by lazy {
+        HttpClient(OkHttp) {
+            install(HttpTimeout) {
+                requestTimeoutMillis = 20000
+                connectTimeoutMillis = 10000
+                socketTimeoutMillis = 20000
+            }
+            expectSuccess = false
+        }
+    }
+
+    /** TTML for the song, null when the service has none, a failure when it could not be reached. */
+    suspend fun getLyrics(title: String, artist: String, duration: Int, album: String? = null): Result<String?> = runCatching {
+        var failure: Throwable? = null
+        var status: HttpStatusCode? = null
+        for (host in HOSTS) {
+            val response = runCatching {
+                client.get("$host/v2/lyrics/get") {
+                    parameter("title", title)
+                    parameter("artist", artist)
+                    if (!album.isNullOrBlank()) parameter("album", album)
+                    if (duration > 0) parameter("duration", duration)
+                    headers { append("User-Agent", "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36") }
+                }
+            }.onFailure { if (it is kotlinx.coroutines.CancellationException) throw it; failure = it }.getOrNull()
+            if (response == null) {
+                log?.invoke("$host unreachable: ${failure?.message}")
+                continue
+            }
+            log?.invoke("$host/v2/lyrics/get -> HTTP ${response.status.value} (\"$title\" - $artist)")
+            status = response.status
+            if (response.status == HttpStatusCode.OK) {
+                return@runCatching toTtml(response.bodyAsText())
+            }
+            if (response.status == HttpStatusCode.NotFound) return@runCatching null
+        }
+        throw failure ?: IOException("LyricsPlus request failed: HTTP ${status?.value}")
+    }
+
+    /** The TTML for a LyricsPlus V2 payload, or null when it holds no lyrics. */
+    internal fun toTtml(body: String): String? {
+        val root = runCatching { json.parseToJsonElement(body).jsonObject }.getOrNull() ?: return null
+        if (root["type"]?.jsonPrimitive?.contentOrNull.equals("None", ignoreCase = true)) return null
+        val lines = (root["lyrics"] as? JsonArray) ?: return null
+        if (lines.isEmpty()) return null
+
+        val head = StringBuilder()
+        val agents = (root["metadata"] as? JsonObject)?.get("agents") as? JsonObject
+        agents?.forEach { (id, value) ->
+            val type = (value as? JsonObject)?.get("type")?.jsonPrimitive?.contentOrNull
+                ?.takeIf { it == "group" } ?: "person"
+            head.append("<ttm:agent type=\"").append(type).append("\" xml:id=\"").append(attr(id)).append("\"/>")
+        }
+
+        val body = StringBuilder()
+        var written = 0
+        for (element in lines) {
+            val line = element as? JsonObject ?: continue
+            val start = line["time"]?.jsonPrimitive?.longOrNull ?: continue
+            val length = line["duration"]?.jsonPrimitive?.longOrNull ?: 0L
+            val text = line["text"]?.jsonPrimitive?.contentOrNull.orEmpty()
+            val singer = (line["element"] as? JsonObject)?.get("singer")?.jsonPrimitive?.contentOrNull
+            val syllables = (line["syllabus"] as? JsonArray).orEmpty().mapNotNull { it as? JsonObject }
+            if (text.isBlank() && syllables.isEmpty()) continue
+
+            body.append("<p begin=\"").append(seconds(start)).append("\" end=\"").append(seconds(start + length)).append('"')
+            if (singer != null && agents?.containsKey(singer) == true) body.append(" ttm:agent=\"").append(attr(singer)).append('"')
+            body.append('>')
+            if (syllables.isEmpty()) {
+                body.append(escape(text.trim()))
+            } else {
+                var background = false
+                for (s in syllables) {
+                    val word = s["text"]?.jsonPrimitive?.contentOrNull.orEmpty()
+                    val sStart = s["time"]?.jsonPrimitive?.longOrNull ?: start
+                    val sLength = s["duration"]?.jsonPrimitive?.longOrNull ?: 0L
+                    val isBackground = s["isBackground"]?.jsonPrimitive?.booleanOrNull == true
+                    if (isBackground != background) {
+                        body.append(if (isBackground) "<span ttm:role=\"x-bg\">" else "</span>")
+                        background = isBackground
+                    }
+                    if (word.isBlank()) { body.append(' '); continue }
+                    // Spaces ride outside the timed span, as in the other converters.
+                    if (word.first().isWhitespace()) body.append(' ')
+                    body.append("<span begin=\"").append(seconds(sStart)).append("\" end=\"")
+                        .append(seconds(sStart + sLength)).append("\">").append(escape(word.trim())).append("</span>")
+                    if (word.last().isWhitespace()) body.append(' ')
+                }
+                if (background) body.append("</span>")
+            }
+            body.append("</p>")
+            written++
+        }
+        if (written == 0) return null
+        return "<tt xmlns=\"http://www.w3.org/ns/ttml\" xmlns:ttm=\"http://www.w3.org/ns/ttml#metadata\">" +
+            "<head><metadata>$head</metadata></head><body><div>$body</div></body></tt>"
+    }
+
+    private fun seconds(ms: Long) = "%d.%03d".format(ms / 1000, ms % 1000)
+    private fun escape(s: String) = s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+    private fun attr(s: String) = escape(s).replace("\"", "&quot;")
+}

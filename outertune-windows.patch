+        if (active) {
+            thread.execute(show)
+            // Windows sometimes drops an update that lands straight after a change of song, which
+            // leaves the card blank until the next one; the same details again a moment later land.
+            thread.execute { Thread.sleep(1_200); if (last === show) show() }
+        }
+    }
+
+    /** Failures here are otherwise silent - the card just stays blank - so they are kept for a bug report. */

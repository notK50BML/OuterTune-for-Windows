+package com.dd3boh.outertune.desktop
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.shape.CircleShape
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawWithContent
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Path
+import androidx.compose.ui.graphics.asComposeRenderEffect
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.graphics.drawscope.clipPath
+import androidx.compose.ui.graphics.drawscope.translate
+import androidx.compose.ui.graphics.layer.GraphicsLayer
+import androidx.compose.ui.graphics.layer.drawLayer
+import androidx.compose.ui.graphics.rememberGraphicsLayer
+import androidx.compose.ui.layout.onGloballyPositioned
+import androidx.compose.ui.layout.positionInRoot
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import org.jetbrains.skia.FilterTileMode
+import org.jetbrains.skia.ImageFilter
+import org.jetbrains.skia.RuntimeEffect
+import org.jetbrains.skia.RuntimeShaderBuilder
+import kotlin.math.min
+
+/*
+ * Liquid glass for the desktop app, drawn with Skia directly (the phone's backdrop library is
+ * Android-only).
+ *
+ * Same idea as the phone's: whatever lies behind a control is recorded once into a layer - the
+ * backdrop - and each glass surface redraws its own patch of that layer, blurred, with its edge
+ * bent like the rim of a lens, a little more saturated, a tint over it and a light edge. That
+ * pipeline (blur, displacement, tint, rim) is the same one the WinUI liquid-glass demo uses.
+ *
+ * The backdrop is the player's background only. A surface must never be part of what it reads, or
+ * drawing it would need itself first, so the controls sit over the backdrop rather than in it.
+ */
+
+/** Where glass can be turned on; each has its own switch in Settings > Appearance > Liquid glass. */
+enum class GlassKind { Controls, Queue, Equalizer, Buttons }
+
+/** What the glass settings say, as read by every surface. */
+object Glass {
+    var enabled by mutableStateOf(false)
+    var controls by mutableStateOf(true)
+    var queue by mutableStateOf(true)
+    var equalizer by mutableStateOf(true)
+    var buttons by mutableStateOf(true)
+
+    /** 0 = frosted and barely bent, 1 = clear and strongly bent. */
+    var intensity by mutableStateOf(0.5f)
+
+    /** Set by the player while its background is the backdrop; null elsewhere. */
+    var backdrop: GlassBackdrop? by mutableStateOf(null)
+
+    fun active(kind: GlassKind): Boolean = enabled && backdrop != null && when (kind) {
+        GlassKind.Controls -> controls
+        GlassKind.Queue -> queue
+        GlassKind.Equalizer -> equalizer
+        GlassKind.Buttons -> buttons
+    }
+}
+
+/** What is recorded behind the glass, and where it sits in the window. */
+class GlassBackdrop(val layer: GraphicsLayer) {
+    var origin: Offset = Offset.Zero
+}
+
+@Composable
+fun rememberGlassBackdrop(): GlassBackdrop {
+    val layer = rememberGraphicsLayer()
+    return remember(layer) { GlassBackdrop(layer) }
+}
+
+/** Marks this as the backdrop: drawn as usual, and recorded for the glass to read. */
+fun Modifier.glassSource(backdrop: GlassBackdrop): Modifier = this
+    .onGloballyPositioned { backdrop.origin = it.positionInRoot() }
+    .drawWithContent {
+        backdrop.layer.record { this@drawWithContent.drawContent() }
+        drawLayer(backdrop.layer)
+    }
+
+private const val GLASS_SKSL = """
+uniform shader content;
+uniform float2 size;
+uniform float radius;
+uniform float depth;
+uniform float refraction;
+uniform float saturation;
+
+float sd(float2 p) {
+    float2 b = size * 0.5 - float2(radius);
+    float2 q = abs(p) - b;
+    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - radius;
+}
+
+half4 main(float2 coord) {
+    float2 p = coord - size * 0.5;
+    float d = sd(p);
+    // 0 on the rim, 1 once well inside it.
+    float t = clamp(-d / depth, 0.0, 1.0);
+    float2 g = float2(sd(p + float2(1.0, 0.0)) - sd(p - float2(1.0, 0.0)),
+                      sd(p + float2(0.0, 1.0)) - sd(p - float2(0.0, 1.0)));
+    float2 n = g / max(length(g), 0.0001);
+    float bend = (1.0 - t) * (1.0 - t) * refraction;
+    float2 src = clamp(coord - n * bend, float2(0.5), size - float2(0.5));
+    half4 c = content.eval(src);
+    half l = dot(c.rgb, half3(0.2126, 0.7152, 0.0722));
+    c.rgb = mix(half3(l), c.rgb, half(saturation));
+    c.rgb += half3(half(0.22 * pow(1.0 - t, 5.0)));
+    return c;
+}
+"""
+
+private val glassEffect: RuntimeEffect? by lazy { runCatching { RuntimeEffect.makeForShader(GLASS_SKSL) }.getOrNull() }
+
+private class GlassCache {
+    var key: List<Float> = emptyList()
+    var filter: androidx.compose.ui.graphics.RenderEffect? = null
+}
+
+/**
+ * [kind] glass over the backdrop, in a rounded shape of [radius] (a full pill or circle when null).
+ * When glass is off for [kind], or the shader cannot be built, this is just [fallback] behind the shape.
+ */
+@Composable
+fun Modifier.liquidGlass(
+    kind: GlassKind,
+    radius: Dp? = null,
+    fallback: Color = Color.Transparent,
+    /** More tint on top of the glass, for surfaces holding text that has to stay readable. */
+    extraTint: Float = 0f,
+): Modifier {
+    val backdrop = Glass.backdrop
+    val effect = glassEffect
+    val shape = if (radius == null) CircleShape else RoundedCornerShape(radius)
+    if (!Glass.active(kind) || backdrop == null || effect == null) {
+        return if (fallback == Color.Transparent) this else this.background(fallback, shape)
+    }
+    val intensity = Glass.intensity.coerceIn(0f, 1f)
+    val own = rememberGraphicsLayer()
+    var origin by remember { mutableStateOf(Offset.Zero) }
+    val cache = remember { GlassCache() }
+    val builder = remember(effect) { RuntimeShaderBuilder(effect) }
+    val base = MaterialTheme.colorScheme.surfaceContainerHigh
+    val tint = base.copy(alpha = (0.30f - 0.20f * intensity + extraTint).coerceIn(0f, 0.95f))
+    val dark = base.red + base.green + base.blue < 1.5f
+    val rim = if (dark) Color.White else Color.White.copy(alpha = 0.9f)
+    return this
+        .onGloballyPositioned { origin = it.positionInRoot() }
+        .drawWithContent {
+            val w = size.width
+            val h = size.height
+            if (w <= 0f || h <= 0f) return@drawWithContent drawContent()
+            val corner = if (radius == null) min(w, h) / 2f else min(radius.toPx(), min(w, h) / 2f)
+            val dp = density
+            val key = listOf(w, h, corner, intensity, dp)
+            if (cache.key != key) {
+                val sigma = (10f - 7.5f * intensity) * dp
+                builder.uniform("size", w, h)
+                builder.uniform("radius", corner)
+                builder.uniform("depth", min(14f * dp, min(w, h) / 2f))
+                builder.uniform("refraction", (6f + 22f * intensity) * dp)
+                builder.uniform("saturation", 1.15f + 0.45f * intensity)
+                cache.filter = ImageFilter.makeRuntimeShader(
+                    builder, "content", ImageFilter.makeBlur(sigma, sigma, FilterTileMode.CLAMP)
+                ).asComposeRenderEffect()
+                cache.key = key
+            }
+            own.renderEffect = cache.filter
+            val shift = origin - backdrop.origin
+            own.record {
+                translate(-shift.x, -shift.y) { drawLayer(backdrop.layer) }
+            }
+            val outline = shape.createOutline(size, layoutDirection, this)
+            val clip = Path().apply { addOutline(outline) }
+            clipPath(clip) {
+                drawLayer(own)
+                drawRect(tint)
+            }
+            drawOutline(
+                outline,
+                brush = Brush.linearGradient(
+                    0f to rim.copy(alpha = 0.55f),
+                    0.45f to rim.copy(alpha = 0.04f),
+                    1f to rim.copy(alpha = 0.28f),
+                ),
+                style = Stroke(1.dp.toPx()),
+            )
+            drawContent()
+        }
+}

                 val u = updater ?: return@runCatching
@@ -205,18 +206,43 @@ object WindowsMediaControls {
                         withHString(album.orEmpty()) { call(second.value, MUSIC2_PUT_ALBUM_TITLE, it) }
                         call(second.value, 2)
                     }
-                    val art = thumbnail(artworkUrl)
+                    // The cover is the part most likely to go wrong (a URL Windows can't build a
+                    // reference for), and it used to sit between the title and the Update call - so
+                    // one failure there meant the title and artist, already set, were never shown
+                    // either: a card with controls and nothing else. It is on its own now.
+                    val art = runCatching { thumbnail(artworkUrl) }.onFailure { log("thumbnail", it) }.getOrNull()
                     // Cleared when there is none, or the last song's cover stays up beside this
                     // song's title - a local file has no web artwork to offer.
-                    call(u, UPDATER_PUT_THUMBNAIL, art)
-                    art?.let { call(it, 2) } // Release: the updater keeps its own reference.
+                    runCatching {
+                        call(u, UPDATER_PUT_THUMBNAIL, art)
+                        art?.let { call(it, 2) } // Release: the updater keeps its own reference.
+                    }.onFailure { log("put thumbnail", it) }
                 }
-                call(u, UPDATER_UPDATE)
+            }.onFailure { log("update", it) }
+            // Always committed, whatever was or was not set above.
+            if (u0 != null) {
+                val hr = runCatching { call(u0, UPDATER_UPDATE) }.onFailure { log("Update()", it) }.getOrDefault(-1)
